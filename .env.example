# ShareWay admin panel (BFF) — example environment.
# Copy to .env and adjust. Read by server/src/config.ts. The panel keeps no secret.

# HTTP port the panel listens on.
PORT=8090

# Base URL of the ShareWay API gateway. Required: every call to a service goes through it.
GATEWAY_URL=http://localhost:8000

# Time budgets in milliseconds.
GATEWAY_TIMEOUT_MS=10000
HEALTH_TIMEOUT_MS=3000

# SQLite file with the audit trail of the lookups.
DB_FILE=./data/panel.db

# Feature flags: on turns the endpoint from a mock to the real gateway call.
FEATURE_REAL_PENDING_DOCS=false
FEATURE_REAL_TRIP_RECORDS=false

# Folder with the built SPA, served by this process in production.
WEB_ROOT=./public

# Pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# --- Keep-warm (optional) ---
# Base URL of each service on Render. The job (server/src/jobs/keep-warm.ts) pings their real
# health endpoint every 13 minutes so the free tier does not put them to sleep: /actuator/health
# for the Spring services and /health for Trip Execution (.NET). Leave one unset to skip it.
HEALTH_PING_DRIVER_MANAGEMENT_URL=https://shareway-driver-management-service.onrender.com
HEALTH_PING_TRIP_PLANNING_MATCHING_URL=https://shareway-trip-planning-matching-service.onrender.com
HEALTH_PING_BOOKING_PRICING_URL=https://shareway-booking-pricing.onrender.com
HEALTH_PING_PAYMENTS_SETTLEMENT_URL=https://shareway-payments-settlement-service.onrender.com
HEALTH_PING_TRIP_EXECUTION_URL=https://shareway-trip-execution.onrender.com
# The gateway itself is also on Render's free tier: if it sleeps, the panel cannot reach any
# service through it even if the services below are awake.
HEALTH_PING_API_GATEWAY_URL=https://shareway-api-gateway.onrender.com
